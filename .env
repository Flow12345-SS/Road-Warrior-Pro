# Road Warrior Pro - Environment Configuration
NODE_ENV=development
PORT=3000

# API Configuration
API_BASE_URL=http://localhost:3000
API_TIMEOUT=30000

# Database Configuration (for future use)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=road_warrior
DB_USER=admin
DB_PASSWORD=

# Supabase Configuration (for future use)
SUPABASE_URL=
SUPABASE_KEY=

# Session Configuration
SESSION_SECRET=road_warrior_secret_key_2024
SESSION_TIMEOUT=86400

# Email Configuration (for future use)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@roadwarrior.com

# File Upload Configuration
MAX_FILE_SIZE=50MB
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Debug Mode
DEBUG=false
